# Vercel에 연결된 Supabase Integration의 환경 변수를 사용합니다.
# 아래 두 값 또는 NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY를 설정하세요.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
# 기존 프로젝트는 SUPABASE_ANON_KEY도 지원합니다.
# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEY는 클라이언트에 사용하지 않습니다.
